config_version=5

[application]

config/name="Trixie's Potion Shop"
config/description="Roguelite incremental de tienda de pociones 2.5D con estética anime/ecchi stream-friendly."
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

