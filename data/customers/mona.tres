[gd_resource type="Resource" script_class="CustomerArchetypeData" format=3]

[ext_resource type="Script" path="res://scripts/resources/CustomerArchetypeData.gd" id="1_70cdo"]

[resource]
script = ExtResource("1_70cdo")
customer_id = &"mona"
display_name = "Mona"
species_archetype = "Elfa Noble Tsundere"
base_patience_sec = 70.0
tip_generosity_mult = 1.15
preferred_recipes = Array[StringName]([&"bruma_lunar", &"tonico_silvestre"])
greeting_lines = PackedStringArray("Solo vine porque mi boticario real cerró temprano. ¡Hazme algo decente!", "¡No creas que hago fila en un puesto callejero porque me gusten tus mezclas!")
satisfied_lines = PackedStringArray("¡Hmph! Pasable para ser alquimia ambulante... te dejo el cambio.", "N-no está nada mal... ¡pero no te confíes!")
spicy_affinity_lines = PackedStringArray("¡Hmph! ¡Deja de sonreír tan coqueta solo porque me gustó tu elixir, tonta!", "Oye... si pasas cerca de mi mansión esta noche, trae un frasco privado... ¡s-solo por cortesía noble!")
impatient_lines = PackedStringArray("¡Inaceptable! ¡Una dama noble no espera tanto!")
display_tempted_lines = PackedStringArray("¿Ese frasco brillante está disponible? ¡Pásamelo antes de que alguien más lo vea!")
